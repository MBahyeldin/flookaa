directive @oneof on INPUT_OBJECT

"""
A span of text inside a block
"""
enum SpanType {
  span
}

type Span {
  _type: SpanType!
  _key: ID!
  text: String!
  marks: [String!]!
}

"""
Mark definitions (annotations) base
"""
interface MarkDef {
  _key: ID!
  _type: MarkDefType!
}

enum MarkDefType {
  link
}

"""
MarkDef for links
"""
type LinkMarkDef implements MarkDef {
  _key: ID!
  _type: MarkDefType!
  href: String!
  title: String
}

"""
Union of all possible markDefs
"""
type MarkDefs {
  link: LinkMarkDef
}

"""
A block of rich text
"""
enum BlockType {
  block
  image
  break
  callout
  quote
  steps
  accordion
  spoiler
  countdown
  checklist
  gallery
  voiceNote
}

enum ImageSize {
  xs
  s
  m
  l
  xl
}

enum ImageAlign {
  left
  center
  right
}

enum GalleryLayout {
  grid
  carousel
}

enum BreakStyle {
  line
  dashed
  dots
  ornament
}

enum CalloutTone {
  info
  success
  warning
  error
}

enum CalloutIcon {
  info
  check
  alert
  error
  lightbulb
  star
  heart
  megaphone
  none
}

enum StyleType {
  normal
  h1
  h2
  h3
  h4
  h5
  h6
  blockquote
}

interface Block {
  _type: BlockType!
  _key: ID!
}

enum ListItemType {
  bullet
  number
}

type BlockBlock implements Block {
  _type: BlockType!
  _key: ID!
  style: StyleType!
  children: [Span!]!
  markDefs: [MarkDefs!]!
  listItem: ListItemType
  level: Int
}

type ImageBlock implements Block {
  _type: BlockType!
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
  size: ImageSize
  align: ImageAlign
}

type BreakBlock implements Block {
  _type: BlockType!
  _key: ID!
  style: BreakStyle
}

type CalloutBlock implements Block {
  _type: BlockType!
  _key: ID!
  tone: CalloutTone
  icon: CalloutIcon
  title: String
  description: String!
}

type QuoteBlock implements Block {
  _type: BlockType!
  _key: ID!
  text: String!
  name: String
  role: String
}

type StepItem {
  _key: ID!
  title: String!
  text: String
}

type StepsBlock implements Block {
  _type: BlockType!
  _key: ID!
  title: String
  items: [StepItem!]!
}

type AccordionItem {
  _key: ID!
  title: String!
  text: String!
}

type AccordionBlock implements Block {
  _type: BlockType!
  _key: ID!
  title: String
  items: [AccordionItem!]!
  allowMultiple: Boolean
  defaultFirstOpen: Boolean
}

type SpoilerBlock implements Block {
  _type: BlockType!
  _key: ID!
  label: String
  content: [Blocks!]!
}

type CountdownBlock implements Block {
  _type: BlockType!
  _key: ID!
  endsAt: DateTime!
  label: String
  endedText: String
}

type ChecklistItem {
  _key: ID!
  text: String!
  checked: Boolean!
}

type ChecklistBlock implements Block {
  _type: BlockType!
  _key: ID!
  title: String
  items: [ChecklistItem!]!
}

type GalleryItem {
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
}

type GalleryBlock implements Block {
  _type: BlockType!
  _key: ID!
  layout: GalleryLayout
  items: [GalleryItem!]!
}

type VoiceNoteBlock implements Block {
  _type: BlockType!
  _key: ID!
  src: String!
  title: String
  duration: Int
}

"""
Union of all possible blocks
"""
type Blocks {
  block: BlockBlock
  image: ImageBlock
  break: BreakBlock
  callout: CalloutBlock
  quote: QuoteBlock
  steps: StepsBlock
  accordion: AccordionBlock
  spoiler: SpoilerBlock
  countdown: CountdownBlock
  checklist: ChecklistBlock
  gallery: GalleryBlock
  voiceNote: VoiceNoteBlock
}

"""
Top-level PortableText document
"""
type PortableText {
  blocks: [Blocks!]!
}

# ===============================
# Inputs
# ===============================

input SpanInput {
  _type: SpanType!
  _key: ID!
  text: String!
  marks: [String!]!
}

input LinkMarkDefInput {
  _key: ID!
  _type: MarkDefType!
  href: String!
  title: String
}

"""
Oneof input for markDefs
"""
input MarkDefInput @oneof {
  link: LinkMarkDefInput
}

"""
Block inputs
"""
input BlockBlockInput {
  _type: BlockType!
  _key: ID!
  style: StyleType!
  children: [SpanInput!]!
  markDefs: [MarkDefInput!]!
  listItem: ListItemType
  level: Int
}

input ImageBlockInput {
  _type: BlockType!
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
  size: ImageSize
  align: ImageAlign
}

input BreakBlockInput {
  _type: BlockType!
  _key: ID!
  style: BreakStyle
}

input CalloutBlockInput {
  _type: BlockType!
  _key: ID!
  tone: CalloutTone
  icon: CalloutIcon
  title: String
  description: String!
}

input QuoteBlockInput {
  _type: BlockType!
  _key: ID!
  text: String!
  name: String
  role: String
}

input StepItemInput {
  _key: ID!
  title: String!
  text: String
}

input StepsBlockInput {
  _type: BlockType!
  _key: ID!
  title: String
  items: [StepItemInput!]!
}

input AccordionItemInput {
  _key: ID!
  title: String!
  text: String!
}

input AccordionBlockInput {
  _type: BlockType!
  _key: ID!
  title: String
  items: [AccordionItemInput!]!
  allowMultiple: Boolean
  defaultFirstOpen: Boolean
}

input SpoilerBlockInput {
  _type: BlockType!
  _key: ID!
  label: String
  content: [BlockInput!]!
}

input CountdownBlockInput {
  _type: BlockType!
  _key: ID!
  endsAt: DateTime!
  label: String
  endedText: String
}

input ChecklistItemInput {
  _key: ID!
  text: String!
  checked: Boolean
}

input ChecklistBlockInput {
  _type: BlockType!
  _key: ID!
  title: String
  items: [ChecklistItemInput!]!
}

input GalleryItemInput {
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
}

input GalleryBlockInput {
  _type: BlockType!
  _key: ID!
  layout: GalleryLayout
  items: [GalleryItemInput!]!
}

input VoiceNoteBlockInput {
  _type: BlockType!
  _key: ID!
  src: String!
  title: String
  duration: Int
}

"""
Oneof input for blocks
"""
input BlockInput @oneof {
  block: BlockBlockInput
  image: ImageBlockInput
  break: BreakBlockInput
  callout: CalloutBlockInput
  quote: QuoteBlockInput
  steps: StepsBlockInput
  accordion: AccordionBlockInput
  spoiler: SpoilerBlockInput
  countdown: CountdownBlockInput
  checklist: ChecklistBlockInput
  gallery: GalleryBlockInput
  voiceNote: VoiceNoteBlockInput
}

input PortableTextInput {
  blocks: [BlockInput!]!
}
