directive @oneof on INPUT_OBJECT

"""
A span of text inside a block
"""
enum SpanType {
  span
}

type Span {
  _type: SpanType!
  _key: ID!
  text: String!
  marks: [String!]!
}

"""
Mark definitions (annotations) base
"""
interface MarkDef {
  _key: ID!
  _type: MarkDefType!
}

enum MarkDefType {
  link
}

"""
MarkDef for links
"""
type LinkMarkDef implements MarkDef {
  _key: ID!
  _type: MarkDefType!
  href: String!
  title: String
}

"""
Union of all possible markDefs
"""
type MarkDefs {
  link: LinkMarkDef
}

"""
A block of rich text
"""
enum BlockType {
  block
  image
  break
  callout
}

enum ImageSize {
  xs
  s
  m
  l
  xl
}

enum ImageAlign {
  left
  center
  right
}

enum CalloutTone {
  info
  success
  warning
  error
}

enum CalloutIcon {
  info
  check
  alert
  error
  lightbulb
  star
  heart
  megaphone
  none
}

enum StyleType {
  normal
  h1
  h2
  h3
  h4
  h5
  h6
  blockquote
}

interface Block {
  _type: BlockType!
  _key: ID!
}

enum ListItemType {
  bullet
  number
}

type BlockBlock implements Block {
  _type: BlockType!
  _key: ID!
  style: StyleType!
  children: [Span!]!
  markDefs: [MarkDefs!]!
  listItem: ListItemType
  level: Int
}

type ImageBlock implements Block {
  _type: BlockType!
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
  size: ImageSize
  align: ImageAlign
}

type BreakBlock implements Block {
  _type: BlockType!
  _key: ID!
}

type CalloutBlock implements Block {
  _type: BlockType!
  _key: ID!
  tone: CalloutTone
  icon: CalloutIcon
  title: String
  description: String!
}

"""
Union of all possible blocks
"""
type Blocks {
  block: BlockBlock
  image: ImageBlock
  break: BreakBlock
  callout: CalloutBlock
}

"""
Top-level PortableText document
"""
type PortableText {
  blocks: [Blocks!]!
}

# ===============================
# Inputs
# ===============================

input SpanInput {
  _type: SpanType!
  _key: ID!
  text: String!
  marks: [String!]!
}

input LinkMarkDefInput {
  _key: ID!
  _type: MarkDefType!
  href: String!
  title: String
}

"""
Oneof input for markDefs
"""
input MarkDefInput @oneof {
  link: LinkMarkDefInput
}

"""
Block inputs
"""
input BlockBlockInput {
  _type: BlockType!
  _key: ID!
  style: StyleType!
  children: [SpanInput!]!
  markDefs: [MarkDefInput!]!
  listItem: ListItemType
  level: Int
}

input ImageBlockInput {
  _type: BlockType!
  _key: ID!
  src: String!
  alt: String
  caption: String
  width: Int
  height: Int
  size: ImageSize
  align: ImageAlign
}

input BreakBlockInput {
  _type: BlockType!
  _key: ID!
}

input CalloutBlockInput {
  _type: BlockType!
  _key: ID!
  tone: CalloutTone
  icon: CalloutIcon
  title: String
  description: String!
}

"""
Oneof input for blocks
"""
input BlockInput @oneof {
  block: BlockBlockInput
  image: ImageBlockInput
  break: BreakBlockInput
  callout: CalloutBlockInput
}

input PortableTextInput {
  blocks: [BlockInput!]!
}
